---
import Layout from '../layouts/Layout.astro';
import tanibotData from '../data/tanibot_data_v2.json';
import { url } from '../utils/paths';

const optList = tanibotData.opt;
---

<Layout title="Pengaduan & Pelaporan Serangan OPT">
  <div class="space-y-8 max-w-4xl mx-auto">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-agro-100 text-agro-800 border border-agro-300">
          Layanan Pelaporan Lapangan
        </span>
        <span class="text-xs text-soil-500">Penyuluh Pertanian Lapangan (PPL) & POPT</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-soil-900 mt-1 tracking-tight">
        Formulir Pengaduan Serangan Hama & Penyakit Padi
      </h1>
      <p class="text-xs sm:text-sm text-soil-600 mt-1">
        Sampaikan laporan insiden ledakan hama di hamparan sawah kelompok tani Anda lengkap dengan bukti foto. Laporan tersimpan di perangkat dan dapat langsung diteruskan ke WhatsApp penyuluh.
      </p>
    </div>

    <!-- The Report Form Card -->
    <div class="bg-white rounded-2xl shadow-sm border border-soil-200 p-6 sm:p-8">
      <form id="pengaduan-form" class="space-y-6">
        <!-- Pelapor & Kontak -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div>
            <label for="nama_pelapor" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
              Nama Lengkap Pelapor / Poktan *
            </label>
            <input 
              type="text" 
              id="nama_pelapor" 
              name="nama_pelapor" 
              required
              placeholder="Contoh: Pak Maryono (Kelompok Tani Makmur)" 
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            />
          </div>

          <div>
            <label for="kontak_hp" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
              Nomor WhatsApp / HP Aktif *
            </label>
            <input 
              type="tel" 
              id="kontak_hp" 
              name="kontak_hp" 
              required
              placeholder="Contoh: 081234567890" 
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            />
          </div>
        </div>

        <!-- Detail OPT, Luas, dan Intensitas -->
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
          <div>
            <label for="jenis_opt" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
              Jenis Hama / Penyakit *
            </label>
            <select 
              id="jenis_opt" 
              name="jenis_opt" 
              required
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            >
              <option value="">Pilih OPT...</option>
              {optList.map((o) => (
                <option value={o.nama_lokal}>{o.nama_lokal} ({o.tipe})</option>
              ))}
              <option value="Lainnya / Gejala Tidak Biasa">Lainnya / Gejala Tidak Biasa</option>
            </select>
          </div>

          <div>
            <label for="luas_serangan" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
              Taksiran Luas Serangan (Ha) *
            </label>
            <input 
              type="number" 
              step="0.1" 
              min="0.1" 
              id="luas_serangan" 
              name="luas_serangan" 
              required
              placeholder="Contoh: 2.5" 
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            />
          </div>

          <div>
            <label for="intensitas_serangan" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
              Intensitas Kerusakan *
            </label>
            <select 
              id="intensitas_serangan" 
              name="intensitas_serangan" 
              required
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            >
              <option value="Ringan (< 25%)">Ringan (&lt; 25%)</option>
              <option value="Sedang (25 - 50%)">Sedang (25 - 50%)</option>
              <option value="Berat (51 - 85%)">Berat (51 - 85%)</option>
              <option value="Puso / Gagal Panen (> 85%)">Puso / Patah Malai (&gt; 85%)</option>
            </select>
          </div>
        </div>

        <!-- Lokasi Hamparan -->
        <div>
          <label for="lokasi_desa" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
            Lokasi Hamparan Sawah (Desa, Kecamatan, Kabupaten) *
          </label>
          <div class="flex gap-2">
            <input 
              type="text" 
              id="lokasi_desa" 
              name="lokasi_desa" 
              required
              placeholder="Contoh: Desa Tanjungmekar, Kec. Pakisjaya, Kab. Karawang" 
              class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
            />
            <button 
              type="button" 
              id="btn-auto-gps-pengaduan"
              title="Gunakan titik koordinat GPS saat ini"
              class="shrink-0 px-3 py-2 rounded-lg bg-soil-100 hover:bg-soil-200 text-soil-700 text-xs font-semibold border border-soil-300 flex items-center gap-1.5 transition-colors cursor-pointer"
            >
              <svg class="w-4 h-4 text-agro-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>GPS</span>
            </button>
          </div>
        </div>

        <!-- Foto Bukti Serangan Lapangan -->
        <div>
          <label class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
            Lampirkan Foto Bukti Serangan di Sawah (Opsional)
          </label>
          <div class="p-4 rounded-xl border border-dashed border-soil-300 bg-soil-50/60 flex flex-col sm:flex-row items-center gap-4">
            <!-- Hidden inputs -->
            <input type="file" id="foto-kamera-input" accept="image/*" capture="environment" class="hidden" />
            <input type="file" id="foto-galeri-input" accept="image/*" class="hidden" />

            <!-- Photo Preview Thumbnail -->
            <div id="foto-preview-wrapper" class="relative w-24 h-24 rounded-lg bg-soil-200 border border-soil-300 overflow-hidden flex items-center justify-center shrink-0">
              <img id="foto-preview-img" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 1 1'%3E%3C/svg%3E" alt="Pratinjau Foto Bukti" class="w-full h-full object-cover hidden" />
              <svg id="foto-placeholder-icon" class="w-8 h-8 text-soil-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              <button type="button" id="btn-hapus-foto" aria-label="Hapus foto bukti" class="hidden absolute top-1 right-1 p-1 bg-black/70 hover:bg-black rounded-full text-white cursor-pointer" title="Hapus foto">
                <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>

            <!-- Upload Buttons -->
            <div class="space-y-2 text-center sm:text-left flex-1">
              <div class="flex flex-wrap gap-2">
                <button 
                  type="button" 
                  id="btn-foto-kamera" 
                  class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-agro-700 hover:bg-agro-800 text-white text-xs font-semibold shadow-xs transition-all"
                >
                  <svg class="w-4 h-4 text-emerald-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z" />
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z" />
                  </svg>
                  <span>Ambil dari Kamera</span>
                </button>
                <button 
                  type="button" 
                  id="btn-foto-galeri" 
                  class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-2 rounded-lg bg-white hover:bg-soil-100 text-soil-800 text-xs font-semibold border border-soil-300 shadow-xs transition-all"
                >
                  <svg class="w-4 h-4 text-soil-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                  </svg>
                  <span>Pilih dari Galeri</span>
                </button>
              </div>
              <p class="text-[11px] text-soil-500">Maksimal 1 foto tanaman/gejala. Foto akan otomatis dikompres agar hemat memori.</p>
            </div>
          </div>
        </div>

        <!-- Keterangan Tambahan -->
        <div>
          <label for="keterangan_gejala" class="block text-xs font-bold uppercase tracking-wider text-soil-700 mb-1.5">
            Keterangan Tambahan / Riwayat Tindakan
          </label>
          <textarea 
            id="keterangan_gejala" 
            name="keterangan_gejala" 
            rows="3" 
            placeholder="Jelaskan kondisi tanaman, umur HST, varietas padi yang ditanam, atau tindakan penyemprotan yang sudah pernah dicoba..." 
            class="w-full text-xs px-3.5 py-2.5 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-white"
          ></textarea>
        </div>

        <div class="pt-2 flex flex-col sm:flex-row items-center justify-between gap-3">
          <div class="flex items-center gap-2 w-full sm:w-auto">
            <button 
              type="submit" 
              class="cursor-pointer w-full sm:w-auto px-6 py-3.5 rounded-xl bg-harvest-gold hover:bg-harvest-dark active:scale-95 text-agro-950 font-black text-xs shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-harvest-amber min-h-[44px]"
            >
              Simpan Laporan Pengaduan
            </button>
          </div>
          <span class="text-xs text-soil-600 font-medium">Tersimpan aman di memori lokal &bull; Tanpa server eksternal</span>
        </div>
      </form>

      <!-- Success Notification Box with Instant WhatsApp Dispatch -->
      <div id="notif-sukses" class="hidden mt-6 p-5 rounded-xl bg-emerald-50 border border-emerald-300 text-emerald-900 text-xs space-y-3">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <div class="flex-1">
            <p class="font-bold text-sm">Laporan Berhasil Disimpan!</p>
            <p class="mt-0.5 text-emerald-800 leading-relaxed">
              Nomor tiket pengaduan telah dicatat di perangkat. Anda dapat langsung meneruskan rangkuman laporan ini ke kontak WhatsApp Penyuluh Pertanian (PPL/POPT) setempat.
            </p>
          </div>
        </div>

        <!-- WhatsApp Action Button -->
        <div class="pt-2 flex flex-wrap items-center gap-2 border-t border-emerald-200">
          <a 
            id="btn-dispatch-wa" 
            href="#" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs shadow-xs transition-all"
          >
            <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Kirimkan ke WhatsApp PPL / Kelompok Tani</span>
          </a>
        </div>
      </div>
    </div>

    <!-- Local Reports History with Search & Actions -->
    <div class="bg-white rounded-2xl shadow-sm border border-soil-200 p-6 space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-soil-200 pb-4">
        <div>
          <h3 class="font-bold text-base text-soil-900">Riwayat Laporan di Perangkat</h3>
          <p class="text-xs text-soil-700 font-medium mt-0.5">Daftar laporan pengaduan yang tersimpan di browser Anda</p>
        </div>

        <div class="flex items-center gap-2">
          <button 
            type="button" 
            id="btn-export-csv" 
            class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-soil-300 hover:border-agro-600 bg-white hover:bg-soil-50 text-xs text-soil-800 font-semibold transition-all shadow-xs"
          >
            <svg class="w-3.5 h-3.5 text-agro-700" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
            </svg>
            <span>Ekspor CSV</span>
          </button>

          <button 
            type="button" 
            id="btn-clear-all" 
            class="cursor-pointer inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-red-200 hover:border-red-400 bg-white hover:bg-red-50 text-xs text-red-700 font-semibold transition-all shadow-xs"
            title="Hapus semua riwayat laporan lokal"
          >
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
            <span>Hapus Semua</span>
          </button>
        </div>
      </div>

      <!-- Quick Search Filter -->
      <div class="relative">
        <input 
          type="text" 
          id="search-laporan-input" 
          placeholder="Cari berdasarkan nama pelapor, lokasi desa, atau jenis OPT..." 
          class="w-full text-xs pl-8 pr-3.5 py-2 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 bg-soil-50/50"
        />
        <svg class="w-4 h-4 text-soil-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
        </svg>
      </div>

      <div id="daftar-laporan" class="space-y-3 text-xs">
        <p class="text-soil-500 italic py-6 text-center">Belum ada laporan pengaduan yang dicatat di perangkat ini.</p>
      </div>
    </div>
  </div>
</Layout>

<script>
  interface ReportRecord {
    id: string;
    tanggal: string;
    nama: string;
    kontak: string;
    opt: string;
    luas: string;
    intensitas: string;
    lokasi: string;
    keterangan: string;
    fotoBase64?: string;
  }

  const STORAGE_KEY = 'agrialert_laporan_list';
  let activeBase64Photo: string | null = null;

  function getStoredReports(): ReportRecord[] {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : [];
    } catch {
      return [];
    }
  }

  function saveReports(list: ReportRecord[]) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(list));
    } catch (e) {
      console.warn("Storage quota warning, removing largest photos if necessary:", e);
    }
    renderReportList();
  }

  function deleteSingleReport(id: string) {
    if (confirm("Hapus laporan ini dari memori perangkat?")) {
      const list = getStoredReports().filter(item => item.id !== id);
      saveReports(list);
    }
  }

  function buildWhatsAppUrl(item: ReportRecord): string {
    const text = `*LAPORAN PENGADUAN SERANGAN OPT PADI*
Tiket: ${item.id}
Tanggal: ${item.tanggal}
----------------------------------------
*Pelapor:* ${item.nama}
*Kontak HP/WA:* ${item.kontak}
*Lokasi Hamparan:* ${item.lokasi}
*Jenis Serangan OPT:* ${item.opt}
*Luas Serangan:* ${item.luas} Hektar
*Intensitas Kerusakan:* ${item.intensitas}
*Keterangan:* ${item.keterangan}
----------------------------------------
_Dikirim via AgriAlert Peringatan Dini Padi Indonesia_`;
    return `https://wa.me/?text=${encodeURIComponent(text)}`;
  }

  function renderReportList(filterQuery: string = '') {
    const container = document.getElementById('daftar-laporan');
    if (!container) return;

    let list = getStoredReports();
    if (filterQuery.trim()) {
      const q = filterQuery.toLowerCase();
      list = list.filter(item => 
        item.nama.toLowerCase().includes(q) ||
        item.lokasi.toLowerCase().includes(q) ||
        item.opt.toLowerCase().includes(q) ||
        item.intensitas.toLowerCase().includes(q)
      );
    }

    if (list.length === 0) {
      container.innerHTML = `<p class="text-soil-500 italic py-6 text-center">${filterQuery ? 'Tidak ada laporan yang cocok dengan pencarian.' : 'Belum ada laporan pengaduan yang dicatat di perangkat ini.'}</p>`;
      return;
    }

    container.innerHTML = list.map(item => `
      <div class="p-4 rounded-xl border border-soil-200 bg-white hover:border-agro-400 transition-colors shadow-2xs space-y-3">
        <div class="flex flex-wrap items-start justify-between gap-2">
          <div class="flex items-start gap-3">
            ${item.fotoBase64 ? `
              <img src="${item.fotoBase64}" alt="Bukti Foto" class="w-14 h-14 rounded-lg object-cover border border-soil-300 shrink-0 bg-soil-100" />
            ` : `
              <div class="w-14 h-14 rounded-lg bg-soil-100 border border-soil-200 flex items-center justify-center text-soil-400 shrink-0">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
              </div>
            `}
            <div>
              <div class="flex items-center gap-2 flex-wrap">
                <strong class="text-soil-900 font-bold text-sm">${item.opt}</strong>
                <span class="px-2 py-0.5 rounded text-[10px] font-bold uppercase bg-amber-100 text-amber-900 border border-amber-300">${item.intensitas}</span>
                <span class="text-soil-600 text-xs font-semibold">${item.luas} Ha</span>
              </div>
              <p class="text-soil-600 text-xs mt-0.5">${item.lokasi}</p>
              <p class="text-soil-500 text-[11px] mt-0.5">Oleh: <strong>${item.nama}</strong> (${item.kontak})</p>
            </div>
          </div>

          <div class="text-right">
            <span class="text-[10px] text-soil-400 font-mono block">${item.tanggal}</span>
            <span class="text-[10px] text-soil-400 font-mono block mt-0.5 font-bold">${item.id}</span>
          </div>
        </div>

        ${item.keterangan && item.keterangan !== '-' ? `
          <div class="p-2.5 rounded-lg bg-soil-50 text-[11px] text-soil-700 border border-soil-200/60">
            <strong>Catatan:</strong> ${item.keterangan}
          </div>
        ` : ''}

        <div class="pt-2 border-t border-soil-100 flex items-center justify-between gap-2">
          <a 
            href="${buildWhatsAppUrl(item)}" 
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-1.5 text-xs text-emerald-700 hover:text-emerald-900 font-bold"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981z"/>
            </svg>
            <span>Bagikan via WhatsApp &rarr;</span>
          </a>

          <button 
            type="button" 
            class="text-xs text-red-600 hover:text-red-800 font-semibold cursor-pointer btn-hapus-item"
            data-id="${item.id}"
          >
            Hapus Laporan
          </button>
        </div>
      </div>
    `).join('');

    // Attach event listeners to delete buttons
    container.querySelectorAll('.btn-hapus-item').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.getAttribute('data-id');
        if (id) deleteSingleReport(id);
      });
    });
  }

  function handlePhotoCompression(file: File) {
    const reader = new FileReader();
    reader.onload = (e) => {
      const img = new Image();
      img.onload = () => {
        const canvas = document.createElement('canvas');
        const MAX_WIDTH = 640;
        const scale = Math.min(1, MAX_WIDTH / img.width);
        canvas.width = img.width * scale;
        canvas.height = img.height * scale;
        const ctx = canvas.getContext('2d');
        if (ctx) {
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          const compressed = canvas.toDataURL('image/jpeg', 0.82);
          activeBase64Photo = compressed;

          const previewImg = document.getElementById('foto-preview-img') as HTMLImageElement;
          const icon = document.getElementById('foto-placeholder-icon');
          const btnHapus = document.getElementById('btn-hapus-foto');

          if (previewImg && icon && btnHapus) {
            previewImg.src = compressed;
            previewImg.classList.remove('hidden');
            icon.classList.add('hidden');
            btnHapus.classList.remove('hidden');
          }
        }
      };
      if (e.target?.result) img.src = e.target.result as string;
    };
    reader.readAsDataURL(file);
  }

  function clearUploadedPhoto() {
    activeBase64Photo = null;
    const previewImg = document.getElementById('foto-preview-img') as HTMLImageElement;
    const icon = document.getElementById('foto-placeholder-icon');
    const btnHapus = document.getElementById('btn-hapus-foto');
    const kameraInput = document.getElementById('foto-kamera-input') as HTMLInputElement;
    const galeriInput = document.getElementById('foto-galeri-input') as HTMLInputElement;

    if (previewImg) previewImg.src = '';
    previewImg?.classList.add('hidden');
    icon?.classList.remove('hidden');
    btnHapus?.classList.add('hidden');
    if (kameraInput) kameraInput.value = '';
    if (galeriInput) galeriInput.value = '';
  }

  function initPengaduan() {
    renderReportList();

    // Check URL search parameters (auto-fill from AI detection)
    const urlParams = new URLSearchParams(window.location.search);
    const prefillOpt = urlParams.get('opt');
    const prefillLoc = urlParams.get('lokasi');
    const prefillDesc = urlParams.get('desc');

    if (prefillOpt) {
      const selectOpt = document.getElementById('jenis_opt') as HTMLSelectElement;
      if (selectOpt) {
        // Find matching option
        for (let i = 0; i < selectOpt.options.length; i++) {
          if (selectOpt.options[i].text.toLowerCase().includes(prefillOpt.toLowerCase()) || 
              selectOpt.options[i].value.toLowerCase().includes(prefillOpt.toLowerCase())) {
            selectOpt.selectedIndex = i;
            break;
          }
        }
      }
    }

    if (prefillLoc) {
      const inputLoc = document.getElementById('lokasi_desa') as HTMLInputElement;
      if (inputLoc) inputLoc.value = prefillLoc;
    }

    if (prefillDesc) {
      const inputDesc = document.getElementById('keterangan_gejala') as HTMLTextAreaElement;
      if (inputDesc) inputDesc.value = prefillDesc;
    }

    // Photo inputs
    const btnFotoKamera = document.getElementById('btn-foto-kamera');
    const btnFotoGaleri = document.getElementById('btn-foto-galeri');
    const kameraInput = document.getElementById('foto-kamera-input') as HTMLInputElement;
    const galeriInput = document.getElementById('foto-galeri-input') as HTMLInputElement;
    const btnHapusFoto = document.getElementById('btn-hapus-foto');

    btnFotoKamera?.addEventListener('click', () => kameraInput?.click());
    btnFotoGaleri?.addEventListener('click', () => galeriInput?.click());
    btnHapusFoto?.addEventListener('click', clearUploadedPhoto);

    kameraInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handlePhotoCompression(file);
    });

    galeriInput?.addEventListener('change', (e) => {
      const file = (e.target as HTMLInputElement).files?.[0];
      if (file) handlePhotoCompression(file);
    });

    // GPS Auto-location for Location input
    const btnGps = document.getElementById('btn-auto-gps-pengaduan');
    btnGps?.addEventListener('click', () => {
      if ('geolocation' in navigator) {
        btnGps.textContent = "Mencari...";
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            const lat = pos.coords.latitude.toFixed(4);
            const lng = pos.coords.longitude.toFixed(4);
            const inputLoc = document.getElementById('lokasi_desa') as HTMLInputElement;
            if (inputLoc) {
              inputLoc.value = `Koordinat GPS: ${lat}, ${lng} (Sawah)`;
            }
            btnGps.innerHTML = `<i class="bi bi-geo-alt-fill text-emerald-600 mr-1"></i> GPS Aktif`;
          },
          () => {
            alert("Izin lokasi GPS tidak diizinkan atau dinonaktifkan.");
            btnGps.innerHTML = `<i class="bi bi-geo-alt mr-1"></i> GPS`;
          },
          { enableHighAccuracy: true, timeout: 8000 }
        );
      }
    });

    // Search filter
    const searchInput = document.getElementById('search-laporan-input') as HTMLInputElement;
    searchInput?.addEventListener('input', () => {
      renderReportList(searchInput.value);
    });

    // Clear all
    const btnClearAll = document.getElementById('btn-clear-all');
    btnClearAll?.addEventListener('click', () => {
      if (confirm("Hapus seluruh catatan laporan di perangkat ini? Data tidak dapat dikembalikan.")) {
        localStorage.removeItem(STORAGE_KEY);
        renderReportList();
      }
    });

    // Form submit
    const form = document.getElementById('pengaduan-form') as HTMLFormElement;
    const notif = document.getElementById('notif-sukses');
    const btnDispatchWa = document.getElementById('btn-dispatch-wa') as HTMLAnchorElement;

    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(form);

      const record: ReportRecord = {
        id: 'LAP-' + Math.floor(100000 + Math.random() * 900000),
        tanggal: new Date().toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' }),
        nama: formData.get('nama_pelapor') as string,
        kontak: formData.get('kontak_hp') as string,
        opt: formData.get('jenis_opt') as string,
        luas: formData.get('luas_serangan') as string,
        intensitas: formData.get('intensitas_serangan') as string,
        lokasi: formData.get('lokasi_desa') as string,
        keterangan: (formData.get('keterangan_gejala') as string) || '-',
        fotoBase64: activeBase64Photo || undefined
      };

      const existing = getStoredReports();
      existing.unshift(record);
      saveReports(existing);

      if (btnDispatchWa) {
        btnDispatchWa.href = buildWhatsAppUrl(record);
      }

      form.reset();
      clearUploadedPhoto();
      notif?.classList.remove('hidden');
      notif?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    // Export CSV
    document.getElementById('btn-export-csv')?.addEventListener('click', () => {
      const list = getStoredReports();
      if (list.length === 0) {
        alert("Tidak ada data laporan untuk diekspor.");
        return;
      }

      let csv = "ID,Tanggal,Nama,Kontak,OPT,Luas_Ha,Intensitas,Lokasi,Keterangan\n";
      list.forEach(item => {
        csv += `"${item.id}","${item.tanggal}","${item.nama}","${item.kontak}","${item.opt}","${item.luas}","${item.intensitas}","${item.lokasi}","${item.keterangan.replace(/"/g, '""')}"\n`;
      });

      const blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
      const urlBlob = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = urlBlob;
      a.download = `laporan_opt_${Date.now()}.csv`;
      a.click();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initPengaduan);
  } else {
    initPengaduan();
  }
</script>
