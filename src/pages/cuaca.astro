---
import Layout from '../layouts/Layout.astro';
import WeatherWidget from '../components/WeatherWidget.astro';
import EnsoChart from '../components/EnsoChart.astro';
import SatelliteChart from '../components/SatelliteChart.astro';
---

<Layout title="Cuaca & Iklim Pertanian">
  <div class="space-y-8">
    <div>
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-semibold bg-agro-100 text-agro-800 border border-agro-300">
          Modul Iklim Cerdas
        </span>
        <span class="text-xs text-soil-500">BMKG & NOAA ERSSTv5</span>
      </div>
      <h1 class="text-2xl sm:text-3xl font-black text-soil-900 mt-1 tracking-tight">
        Analisis Cuaca, Iklim & Penginderaan Jauh
      </h1>
      <p class="text-xs sm:text-sm text-soil-600 mt-1">
        Pemantauan cuaca mikro sawah berbasis GPS, dinamika El Niño/La Niña dengan model LSTM, dan tren vegetasi satelit Sentinel.
      </p>
    </div>

    <!-- Live Weather Widget with GPS -->
    <WeatherWidget />

    <!-- Dual Chart Grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <EnsoChart />
      <SatelliteChart />
    </div>

    <!-- Agronomic Planting Calendar Table -->
    <div class="bg-white rounded-2xl shadow-sm border border-soil-200 overflow-hidden">
      <div class="p-6 border-b border-soil-200">
        <h3 class="text-lg font-bold text-soil-900 tracking-tight">Panduan Pola Tanam Adaptif Iklim</h3>
        <p class="text-xs text-soil-600 mt-0.5">Penyesuaian waktu olah tanah dan pemilihan varietas padi berdasarkan anomali curah hujan</p>
      </div>

      <div class="overflow-x-auto">
        <table class="w-full text-left text-xs">
          <thead class="bg-soil-100/70 text-soil-700 font-bold uppercase tracking-wider border-b border-soil-200">
            <tr>
              <th class="p-4">Fase Iklim</th>
              <th class="p-4">Karakteristik Curah Hujan</th>
              <th class="p-4">Rekomendasi Varietas Padi</th>
              <th class="p-4">Strategi Pengelolaan Air</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-soil-100 text-soil-800">
            <tr class="hover:bg-soil-50 transition-colors">
              <td class="p-4 font-bold text-amber-800">El Niño (Anomali Kering)</td>
              <td class="p-4">Curah hujan di bawah normal, awal musim hujan mundur.</td>
              <td class="p-4">Inpago 8, Inpago 9, Inpari 42 GSR (toleran kekeringan, hemat air).</td>
              <td class="p-4">Penerapan pengairan berselang (Intermittent Irrigation) dan pompanisasi sumur dangkal.</td>
            </tr>
            <tr class="hover:bg-soil-50 transition-colors">
              <td class="p-4 font-bold text-blue-800">La Niña (Anomali Basah)</td>
              <td class="p-4">Curah hujan tinggi dan frekuensi hujan lebat meningkat drastis.</td>
              <td class="p-4">Inpara 2, Inpara 3, Inpari 30 Ciherang Sub-1 (toleran rendaman).</td>
              <td class="p-4">Normalisasi saluran drainase sawah, hindari pupuk Urea berlebih untuk menekan jamur blas.</td>
            </tr>
            <tr class="hover:bg-soil-50 transition-colors">
              <td class="p-4 font-bold text-agro-800">Fase Netral</td>
              <td class="p-4">Pola hujan sesuai rata-rata klimatologis 30 tahun.</td>
              <td class="p-4">Inpari 32 HDB, Ciherang, Mekongga, Situbagendit.</td>
              <td class="p-4">Pola tanam Padi - Padi - Palawija (kedelai/jagung/kacang hijau) untuk memutus siklus hama.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</Layout>

