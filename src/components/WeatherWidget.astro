---
// WeatherWidget.astro - Live Geolocation & Realtime Hourly Weather Forecasting
import { url } from '../utils/paths';
---

<div class="bg-white rounded-2xl shadow-sm border border-soil-200 overflow-hidden" id="weather-widget">
  <!-- Top Status Banner with Real GPS & Maps Icon Assets -->
  <div class="p-5 bg-gradient-to-r from-soil-900 to-soil-800 text-white flex flex-wrap items-center justify-between gap-4">
    <div class="flex items-center gap-3">
      <div class="w-11 h-11 rounded-xl bg-soil-800/90 border border-soil-700 flex items-center justify-center p-1.5 shadow-inner">
        <img src={url('/images/gps.png')} alt="GPS" width="28" height="28" class="w-7 h-7 object-contain" />
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 id="lokasi-nama" class="font-bold text-base tracking-tight text-white">Sentra Padi Karawang, Jawa Barat</h3>
          <span id="gps-status-pill" class="text-[10px] font-bold px-2 py-0.5 rounded bg-agro-800 text-agro-200 border border-agro-700">GPS Standar</span>
        </div>
        <div class="flex items-center gap-2 text-xs text-soil-300 font-mono mt-0.5">
          <img src={url('/images/maps.png')} alt="Peta" width="14" height="14" class="w-3.5 h-3.5 object-contain opacity-80" />
          <span id="lokasi-koordinat">-6.3034° LS, 107.3069° BT &bull; Elevasi 18m dpl</span>
        </div>
      </div>
    </div>

    <!-- GPS Activation Button -->
    <button 
      type="button" 
      id="btn-activate-gps"
      class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-harvest-gold hover:bg-harvest-dark active:scale-95 text-agro-950 text-xs font-black shadow-sm transition-all focus:outline-none focus:ring-2 focus:ring-harvest-amber cursor-pointer min-h-[44px]"
    >
      <svg class="w-4 h-4 animate-spin hidden text-agro-950" id="gps-spinner" fill="none" viewBox="0 0 24 24">
        <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
        <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
      </svg>
      <img src={url('/images/gps.png')} id="gps-icon" alt="GPS Icon" width="16" height="16" class="w-4 h-4 object-contain brightness-0" />
      <span id="gps-btn-text">Perbarui dengan Lokasi Sawah Saya</span>
    </button>
  </div>

  <!-- Telemetry Grid with Sun Condition Highlight Card -->
  <div class="p-6 grid grid-cols-2 sm:grid-cols-4 gap-4 bg-soil-50/50 border-b border-soil-200">
    <div class="p-4 rounded-xl bg-white border border-soil-200 shadow-xs relative overflow-hidden">
      <div class="flex items-start justify-between">
        <div>
          <span class="text-xs text-soil-700 font-semibold block">Suhu Udara</span>
          <p id="cuaca-suhu" class="text-2xl font-black text-soil-900 mt-1">31.2<span class="text-sm font-semibold text-soil-600">°C</span></p>
          <span id="cuaca-suhu-sub" class="text-[11px] text-soil-600 font-medium mt-0.5 block">Ideal padi: 24°–32°C</span>
        </div>
        <img src={url('/images/sun.png')} alt="Matahari" width="40" height="40" class="w-10 h-10 object-contain drop-shadow-sm opacity-90" />
      </div>
    </div>

    <div class="p-4 rounded-xl bg-white border border-soil-200 shadow-xs">
      <span class="text-xs text-soil-700 font-semibold block">Curah Hujan Hari Ini</span>
      <p id="cuaca-hujan" class="text-2xl font-black text-soil-900 mt-1">4.2<span class="text-sm font-semibold text-soil-600"> mm</span></p>
      <span id="cuaca-hujan-label" class="text-[11px] text-agro-800 font-bold block mt-0.5">Hujan Ringan</span>
    </div>

    <div class="p-4 rounded-xl bg-white border border-soil-200 shadow-xs">
      <span class="text-xs text-soil-700 font-semibold block">Kelembapan Udara (RH)</span>
      <p id="cuaca-rh" class="text-2xl font-black text-soil-900 mt-1">79<span class="text-sm font-semibold text-soil-600">%</span></p>
      <span id="cuaca-rh-sub" class="text-[11px] text-soil-600 font-medium mt-0.5 block">Optimal fotosintesis</span>
    </div>

    <div class="p-4 rounded-xl bg-white border border-soil-200 shadow-xs">
      <span class="text-xs text-soil-700 font-semibold block">Status Musim Tanam</span>
      <p id="cuaca-musim" class="text-2xl font-black text-agro-800 mt-1">MT 1</p>
      <span class="text-[11px] text-soil-600 font-medium mt-0.5 block">Musim Hujan Rendengan</span>
    </div>
  </div>

  <!-- Realtime Hourly Weather Forecast Chart -->
  <div class="p-6 bg-white border-b border-soil-200">
    <div class="flex flex-wrap items-center justify-between gap-3 mb-4">
      <div>
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse"></span>
          <h4 class="font-bold text-soil-900 text-sm tracking-tight">Grafik Prakiraan Cuaca 24 Jam (Real-time)</h4>
          <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-300">
            Open-Meteo &bull; Live
          </span>
        </div>
        <p class="text-xs text-soil-600 font-medium mt-0.5">Dinamika fluktuasi suhu, kelembapan spora, dan curah hujan per jam di sawah Anda</p>
      </div>

      <!-- Realtime Metric Mode Switcher Tabs with Bootstrap Icons -->
      <div class="flex items-center p-1 bg-soil-100 rounded-lg border border-soil-200 text-xs font-semibold">
        <button 
          type="button" 
          id="btn-metric-temp" 
          class="cursor-pointer px-3 py-1.5 rounded-md bg-white text-agro-950 font-bold shadow-xs transition-all border border-soil-200 inline-flex items-center gap-1.5 min-h-[36px]"
        >
          <i class="bi bi-thermometer-half text-red-600 text-sm"></i>
          <span>Suhu (°C)</span>
        </button>
        <button 
          type="button" 
          id="btn-metric-rh" 
          class="cursor-pointer px-3 py-1.5 rounded-md text-soil-700 hover:text-soil-950 font-semibold transition-all hover:bg-soil-200/60 inline-flex items-center gap-1.5 min-h-[36px]"
        >
          <i class="bi bi-droplet-half text-blue-600 text-sm"></i>
          <span>Kelembapan (%)</span>
        </button>
        <button 
          type="button" 
          id="btn-metric-rain" 
          class="cursor-pointer px-3 py-1.5 rounded-md text-soil-700 hover:text-soil-950 font-semibold transition-all hover:bg-soil-200/60 inline-flex items-center gap-1.5 min-h-[36px]"
        >
          <i class="bi bi-cloud-rain-heavy text-sky-600 text-sm"></i>
          <span>Hujan (mm)</span>
        </button>
      </div>
    </div>

    <!-- Chart Canvas Container -->
    <div class="relative w-full h-[260px] bg-soil-50/30 rounded-xl p-2 border border-soil-100">
      <canvas id="hourly-weather-canvas"></canvas>
    </div>
  </div>

  <!-- Agronomic Advisory Box -->
  <div class="p-6 bg-white">
    <div class="flex items-start gap-4">
      <div class="w-10 h-10 rounded-xl bg-agro-100 text-agro-800 flex items-center justify-center shrink-0 mt-0.5">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div class="space-y-1">
        <h4 class="text-xs font-bold uppercase tracking-wider text-soil-600">Rekomendasi Agronomi & Pola Tanam Berdasarkan Iklim:</h4>
        <p id="cuaca-saran" class="text-sm text-soil-800 leading-relaxed font-medium">
          Kondisi cuaca saat ini mendukung pertumbuhan vegetatif padi. Jika kelembapan malam hari melebihi 85%, waspadai pembentukan embun panjang yang memicu perkecambahan spora Blas Daun (Pyricularia oryzae). Pertahankan sirkulasi air mengalir berselang.
        </p>
      </div>
    </div>
  </div>
</div>

<script>
  import { Chart, LineController, BarController, LineElement, BarElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend, Filler } from 'chart.js';

  Chart.register(LineController, BarController, LineElement, BarElement, PointElement, LinearScale, CategoryScale, Tooltip, Legend, Filler);

  const PROVINSI_PADI = [
    { nama: "Karawang, Jawa Barat", lat: -6.30, lon: 107.30, elev: "18m dpl" },
    { nama: "Indramayu, Jawa Barat", lat: -6.32, lon: 108.32, elev: "8m dpl" },
    { nama: "Subang, Jawa Barat", lat: -6.57, lon: 107.76, elev: "35m dpl" },
    { nama: "Klaten, Jawa Tengah", lat: -7.70, lon: 110.60, elev: "155m dpl" },
    { nama: "Ngawi, Jawa Timur", lat: -7.40, lon: 111.45, elev: "58m dpl" },
    { nama: "Sidrap, Sulawesi Selatan", lat: -3.92, lon: 119.80, elev: "42m dpl" },
    { nama: "Deli Serdang, Sumatera Utara", lat: 3.55, lon: 98.85, elev: "24m dpl" }
  ];

  let weatherChart: Chart | null = null;
  let currentMetricMode: 'temp' | 'rh' | 'rain' = 'temp';

  // Baseline 24h data fallback
  let hourlyTimes = ["00:00", "02:00", "04:00", "06:00", "08:00", "10:00", "12:00", "14:00", "16:00", "18:00", "20:00", "22:00"];
  let hourlyTemps = [25.1, 24.8, 24.2, 25.5, 28.3, 31.0, 32.8, 32.4, 30.2, 28.1, 26.9, 25.8];
  let hourlyRH    = [92, 94, 96, 91, 79, 68, 64, 66, 74, 82, 87, 90];
  let hourlyRain  = [0.0, 0.0, 0.2, 0.0, 0.0, 0.0, 0.5, 1.8, 1.2, 0.4, 0.0, 0.0];

  function hitungJarak(lat1: number, lon1: number, lat2: number, lon2: number) {
    const R = 6371;
    const dLat = (lat2 - lat1) * Math.PI / 180;
    const dLon = (lon2 - lon1) * Math.PI / 180;
    const a = Math.sin(dLat/2) * Math.sin(dLat/2) +
              Math.cos(lat1 * Math.PI / 180) * Math.cos(lat2 * Math.PI / 180) *
              Math.sin(dLon/2) * Math.sin(dLon/2);
    const c = 2 * Math.atan2(Math.sqrt(a), Math.sqrt(1-a));
    return R * c;
  }

  function getProvTerdekat(lat: number, lon: number) {
    let best = PROVINSI_PADI[0];
    let minDist = hitungJarak(lat, lon, best.lat, best.lon);
    for (const p of PROVINSI_PADI) {
      const d = hitungJarak(lat, lon, p.lat, p.lon);
      if (d < minDist) {
        minDist = d;
        best = p;
      }
    }
    return best;
  }

  function renderChart() {
    const canvas = document.getElementById('hourly-weather-canvas') as HTMLCanvasElement;
    if (!canvas) return;

    if (weatherChart) {
      weatherChart.destroy();
    }

    let datasetConfig: any = {};
    let yAxisConfig: any = {};

    if (currentMetricMode === 'temp') {
      datasetConfig = {
        label: 'Suhu Udara (°C)',
        data: hourlyTemps,
        borderColor: '#D97706',
        backgroundColor: 'rgba(217, 119, 6, 0.10)',
        borderWidth: 2.5,
        fill: true,
        tension: 0.35,
        pointRadius: 3.5,
        pointBackgroundColor: '#D97706'
      };
      yAxisConfig = {
        min: 20,
        max: 38,
        ticks: {
          callback: (v: any) => `${v}°C`,
          font: { size: 10 },
          color: '#795D4A'
        }
      };
    } else if (currentMetricMode === 'rh') {
      datasetConfig = {
        label: 'Kelembapan Udara (%)',
        data: hourlyRH,
        borderColor: '#0284C7',
        backgroundColor: 'rgba(2, 132, 199, 0.12)',
        borderWidth: 2.5,
        fill: true,
        tension: 0.35,
        pointRadius: 3.5,
        pointBackgroundColor: '#0284C7'
      };
      yAxisConfig = {
        min: 50,
        max: 100,
        ticks: {
          callback: (v: any) => `${v}%`,
          font: { size: 10 },
          color: '#795D4A'
        }
      };
    } else {
      datasetConfig = {
        type: 'bar',
        label: 'Curah Hujan (mm)',
        data: hourlyRain,
        backgroundColor: 'rgba(56, 109, 58, 0.65)',
        borderColor: '#2D562F',
        borderWidth: 1.5,
        borderRadius: 4
      };
      yAxisConfig = {
        min: 0,
        ticks: {
          callback: (v: any) => `${v} mm`,
          font: { size: 10 },
          color: '#795D4A'
        }
      };
    }

    weatherChart = new Chart(canvas, {
      type: currentMetricMode === 'rain' ? 'bar' : 'line',
      data: {
        labels: hourlyTimes,
        datasets: [datasetConfig]
      },
      options: {
        responsive: true,
        maintainAspectRatio: false,
        plugins: {
          legend: { display: false },
          tooltip: {
            backgroundColor: '#1F3921',
            padding: 10,
            callbacks: {
              label: (ctx) => {
                if (currentMetricMode === 'temp') return `Suhu: ${ctx.parsed.y.toFixed(1)} °C`;
                if (currentMetricMode === 'rh') return `Kelembapan: ${ctx.parsed.y}% RH`;
                return `Hujan: ${ctx.parsed.y.toFixed(1)} mm`;
              }
            }
          }
        },
        scales: {
          x: {
            grid: { display: false },
            ticks: {
              font: { size: 10 },
              color: '#795D4A'
            }
          },
          y: {
            grid: { color: 'rgba(228, 217, 206, 0.6)' },
            ...yAxisConfig
          }
        }
      }
    });
  }

  async function fetchRealtimeWeather(lat: number, lon: number) {
    try {
      const url = `https://api.open-meteo.com/v1/forecast?latitude=${lat.toFixed(4)}&longitude=${lon.toFixed(4)}&hourly=temperature_2m,relative_humidity_2m,rain&current=temperature_2m,relative_humidity_2m,rain&timezone=auto&forecast_days=1`;
      const res = await fetch(url);
      if (!res.ok) return;

      const data = await res.json();
      if (!data.hourly) return;

      // Extract every 2nd hour for clean chart labels (00:00, 02:00, 04:00, ...)
      const fullTimes = data.hourly.time || [];
      const fullTemps = data.hourly.temperature_2m || [];
      const fullRH    = data.hourly.relative_humidity_2m || [];
      const fullRain  = data.hourly.rain || [];

      const filteredTimes: string[] = [];
      const filteredTemps: number[] = [];
      const filteredRH: number[]    = [];
      const filteredRain: number[]  = [];

      for (let i = 0; i < Math.min(24, fullTimes.length); i += 2) {
        const tStr = fullTimes[i].split('T')[1] || fullTimes[i];
        filteredTimes.push(tStr.slice(0, 5));
        filteredTemps.push(fullTemps[i]);
        filteredRH.push(fullRH[i]);
        filteredRain.push(fullRain[i]);
      }

      hourlyTimes = filteredTimes;
      hourlyTemps = filteredTemps;
      hourlyRH    = filteredRH;
      hourlyRain  = filteredRain;

      // Update current telemetry
      if (data.current) {
        const curTemp = document.getElementById('cuaca-suhu');
        const curRh = document.getElementById('cuaca-rh');
        const curRain = document.getElementById('cuaca-hujan');

        if (curTemp && data.current.temperature_2m !== undefined) {
          curTemp.innerHTML = `${data.current.temperature_2m.toFixed(1)}<span class="text-sm font-semibold text-soil-500">°C</span>`;
        }
        if (curRh && data.current.relative_humidity_2m !== undefined) {
          curRh.innerHTML = `${Math.round(data.current.relative_humidity_2m)}<span class="text-sm font-semibold text-soil-500">%</span>`;
        }
        if (curRain && data.current.rain !== undefined) {
          curRain.innerHTML = `${data.current.rain.toFixed(1)}<span class="text-sm font-semibold text-soil-500"> mm</span>`;
        }
      }

      renderChart();
    } catch (err) {
      console.warn("Could not fetch realtime Open-Meteo, using calibrated baseline:", err);
      renderChart();
    }
  }

  function updateDisplay(lat: number, lon: number, isGps: boolean) {
    const prov = getProvTerdekat(lat, lon);
    const namaEl = document.getElementById('lokasi-nama');
    const coordEl = document.getElementById('lokasi-koordinat');
    const pillEl = document.getElementById('gps-status-pill');

    if (namaEl) namaEl.textContent = isGps ? `Lokasi Sawah Anda (dekat ${prov.nama})` : prov.nama;
    if (coordEl) coordEl.textContent = `${lat.toFixed(4)}° LS, ${lon.toFixed(4)}° BT • ${prov.elev}`;
    if (pillEl) {
      pillEl.textContent = isGps ? "GPS Aktif (Live)" : "GPS Standar";
      pillEl.className = isGps 
        ? "text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-700 text-emerald-100 border border-emerald-600"
        : "text-[10px] font-bold px-2 py-0.5 rounded bg-agro-800 text-agro-200 border border-agro-700";
    }

    fetchRealtimeWeather(lat, lon);
  }

  function initWeatherComponent() {
    renderChart();

    // Fetch initial default location realtime weather (Karawang)
    fetchRealtimeWeather(-6.30, 107.30);

    // Tab switcher events
    const btnTemp = document.getElementById('btn-metric-temp');
    const btnRh = document.getElementById('btn-metric-rh');
    const btnRain = document.getElementById('btn-metric-rain');

    const updateTabStyles = (active: 'temp' | 'rh' | 'rain') => {
      currentMetricMode = active;
      const activeCls = "cursor-pointer px-3 py-1.5 rounded-md bg-white text-agro-900 font-bold shadow-xs transition-all border border-soil-200";
      const inactiveCls = "cursor-pointer px-3 py-1.5 rounded-md text-soil-600 hover:text-soil-900 font-semibold transition-all hover:bg-soil-200/60";

      if (btnTemp) btnTemp.className = active === 'temp' ? activeCls : inactiveCls;
      if (btnRh) btnRh.className = active === 'rh' ? activeCls : inactiveCls;
      if (btnRain) btnRain.className = active === 'rain' ? activeCls : inactiveCls;

      renderChart();
    };

    btnTemp?.addEventListener('click', () => updateTabStyles('temp'));
    btnRh?.addEventListener('click', () => updateTabStyles('rh'));
    btnRain?.addEventListener('click', () => updateTabStyles('rain'));

    // GPS Click
    const btnGps = document.getElementById('btn-activate-gps');
    const spinner = document.getElementById('gps-spinner');
    const icon = document.getElementById('gps-icon');
    const btnText = document.getElementById('gps-btn-text');

    btnGps?.addEventListener('click', () => {
      if (!navigator.geolocation) {
        alert("Peramban Anda tidak mendukung Geolocation.");
        return;
      }

      spinner?.classList.remove('hidden');
      icon?.classList.add('hidden');
      if (btnText) btnText.textContent = "Mencari Koordinat GPS Sawah...";

      navigator.geolocation.getCurrentPosition(
        (pos) => {
          spinner?.classList.add('hidden');
          icon?.classList.remove('hidden');
          if (btnText) btnText.textContent = "GPS Terhubung";
          updateDisplay(pos.coords.latitude, pos.coords.longitude, true);
        },
        (err) => {
          spinner?.classList.add('hidden');
          icon?.classList.remove('hidden');
          if (btnText) btnText.textContent = "Gagal (Gunakan Default)";
          console.warn("Geolocation error:", err.message);
        },
        { enableHighAccuracy: true, timeout: 8000 }
      );
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initWeatherComponent);
  } else {
    initWeatherComponent();
  }
</script>
