---
// TaniBotChat.astro - Interactive Offline Decision Tree & Agronomist Chatbot
import tanibotData from '../data/tanibot_data_v2.json';
---

<div class="bg-white rounded-2xl shadow-sm border border-soil-200 overflow-hidden flex flex-col h-[750px] max-h-[85vh]">
  <!-- Chat Header -->
  <div class="p-4 sm:p-5 bg-gradient-to-r from-agro-900 to-agro-800 text-white flex items-center justify-between border-b border-agro-700">
    <div class="flex items-center gap-3">
      <div class="relative">
        <img src="/images/mascot.png" alt="TaniBot Mascot" class="w-10 h-10 object-contain rounded-full bg-white/10 p-1 border border-white/20" />
        <span class="absolute bottom-0 right-0 w-3 h-3 rounded-full bg-emerald-400 border-2 border-agro-900"></span>
      </div>
      <div>
        <div class="flex items-center gap-2">
          <h3 class="font-bold text-base tracking-tight">TaniBot Offline</h3>
          <span class="text-[10px] uppercase font-bold px-2 py-0.5 rounded bg-agro-700/80 text-agro-200 border border-agro-600">BBPOPT Kementan</span>
        </div>
        <p class="text-xs text-agro-300">Asisten Cerdas Penanganan OPT & Pemupukan Padi</p>
      </div>
    </div>

    <!-- Quick Navigation Reset -->
    <div class="flex items-center gap-2">
      <button 
        type="button" 
        id="btn-tanibot-reset" 
        class="text-xs text-agro-200 hover:text-white bg-agro-800/80 hover:bg-agro-700 px-3 py-1.5 rounded-lg border border-agro-600 transition-colors flex items-center gap-1.5"
      >
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15" />
        </svg>
        <span>Mulai Ulang</span>
      </button>
    </div>
  </div>

  <!-- Search Filter Bar -->
  <div class="p-3 bg-soil-50 border-b border-soil-200">
    <div class="relative">
      <input 
        type="text" 
        id="tanibot-search" 
        placeholder="Cari kata kunci: blas, wereng, dosis urea, varietas tahan..." 
        class="w-full text-xs pl-8 pr-4 py-2 rounded-lg border border-soil-300 focus:outline-none focus:ring-2 focus:ring-agro-600 focus:border-agro-600 bg-white"
      />
      <svg class="w-4 h-4 text-soil-400 absolute left-2.5 top-2.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
    </div>
  </div>

  <!-- Messages History Viewport -->
  <div id="tanibot-messages" class="flex-1 p-4 sm:p-6 overflow-y-auto space-y-4 bg-soil-50/40">
    <!-- Messages injected dynamically via JS -->
  </div>

  <!-- Bottom Options Dock -->
  <div id="tanibot-options-dock" class="p-4 bg-white border-t border-soil-200 space-y-2">
    <p class="text-[11px] font-semibold text-soil-500 uppercase tracking-wider mb-2">Pilih Langkah atau Topik:</p>
    <div id="tanibot-options-container" class="flex flex-wrap gap-2">
      <!-- Option buttons rendered here -->
    </div>
  </div>
</div>

<!-- Raw data script injection -->
<script is:inline id="tanibot-raw-data" type="application/json">
  {JSON.stringify(tanibotData)}
</script>

<script>
  interface OptionItem {
    id: string;
    label: string;
    targetNode?: string;
  }

  interface RecItem {
    metode: string;
    langkah: string;
    detail: string;
    dosis: string | null;
    waktu_aplikasi: string | null;
    sumber: string;
  }

  const rawJsonEl = document.getElementById('tanibot-raw-data');
  const data = rawJsonEl ? JSON.parse(rawJsonEl.textContent || '{}') : {};

  const tree: any[] = data.tree || [];
  const optList: any[] = data.opt || [];
  const recsMap: Record<string, any[]> = data.recs || {};
  const varsMap: Record<string, any[]> = data.vars || {};
  const pupukList: any[] = data.pupuk || [];
  const faqMap: Record<string, any[]> = data.faq || {};

  let currentNodeId = 'root';
  const historyStack: string[] = [];

  function findNode(nodeId: string) {
    return tree.find(n => n.id === nodeId);
  }

  function getChildOptions(parentNodeId: string) {
    return tree.filter(n => n.pid === parentNodeId);
  }

  function renderBotBubble(text: string, recs: RecItem[] = [], meta: any = null) {
    const container = document.getElementById('tanibot-messages');
    if (!container) return;

    const wrapper = document.createElement('div');
    wrapper.className = "flex gap-3 items-start max-w-2xl";

    let recsHtml = '';
    if (recs && recs.length > 0) {
      recsHtml = `
        <div class="mt-3 space-y-2.5 pt-3 border-t border-agro-200">
          <p class="text-xs font-bold text-agro-900 uppercase tracking-wider flex items-center gap-1.5">
            📋 Rekomendasi Tindakan:
          </p>
          ${recs.map((r, i) => `
            <div class="p-3 rounded-lg bg-white/90 border border-agro-200 text-xs shadow-sm space-y-1">
              <div class="flex items-center justify-between gap-2">
                <strong class="text-soil-900 font-bold">${i + 1}. [${r.metode.toUpperCase()}] ${r.langkah}</strong>
              </div>
              <p class="text-soil-700 leading-relaxed">${r.detail}</p>
              ${r.dosis ? `<p class="text-agro-800 font-medium">💊 <strong>Dosis:</strong> ${r.dosis}</p>` : ''}
              ${r.waktu_aplikasi ? `<p class="text-soil-600">🕐 <strong>Waktu Aplikasi:</strong> ${r.waktu_aplikasi}</p>` : ''}
              <p class="text-[10px] text-soil-500 pt-1 italic">Rujukan: ${r.sumber}</p>
            </div>
          `).join('')}
        </div>
      `;
    }

    wrapper.innerHTML = `
      <img src="/images/mascot.png" alt="TaniBot" class="w-8 h-8 rounded-full p-0.5 bg-agro-100 border border-agro-300 shrink-0 mt-0.5" />
      <div class="bg-agro-50 border border-agro-200/80 rounded-2xl rounded-tl-none p-4 text-xs text-soil-800 shadow-sm leading-relaxed">
        <p class="whitespace-pre-line text-sm font-medium text-soil-900">${text}</p>
        ${recsHtml}
      </div>
    `;

    container.appendChild(wrapper);
    container.scrollTop = container.scrollHeight;
  }

  function renderUserBubble(text: string) {
    const container = document.getElementById('tanibot-messages');
    if (!container) return;

    const wrapper = document.createElement('div');
    wrapper.className = "flex justify-end";
    wrapper.innerHTML = `
      <div class="bg-agro-800 text-white rounded-2xl rounded-tr-none px-4 py-2.5 text-xs font-medium max-w-md shadow-sm">
        ${text}
      </div>
    `;
    container.appendChild(wrapper);
    container.scrollTop = container.scrollHeight;
  }

  function setOptions(options: { id: string; label: string; action: () => void }[]) {
    const dock = document.getElementById('tanibot-options-container');
    if (!dock) return;
    dock.innerHTML = '';

    options.forEach(opt => {
      const btn = document.createElement('button');
      btn.type = 'button';
      btn.className = "px-3 py-2 rounded-lg bg-soil-100 hover:bg-agro-700 hover:text-white text-soil-800 text-xs font-medium border border-soil-300 transition-colors shadow-sm text-left";
      btn.textContent = opt.label;
      btn.addEventListener('click', opt.action);
      dock.appendChild(btn);
    });
  }

  function navigateToNode(nodeId: string) {
    const node = findNode(nodeId);
    if (!node) return;

    currentNodeId = nodeId;
    const children = getChildOptions(nodeId);

    // If node has specific meta handler (e.g. fertilizer or opt)
    if (nodeId === 'opt_pupuk') {
      let pupukText = "Berikut adalah anjuran pemupukan berimbang untuk padi sawah berdasarkan uji tanah:";
      const recItems: RecItem[] = pupukList.map(p => ({
        metode: 'Pemupukan',
        langkah: p.jenis_pupuk,
        detail: `${p.dosis_per_ha} (${p.catatan})`,
        dosis: p.dosis_per_ha,
        waktu_aplikasi: p.waktu_aplikasi,
        sumber: p.sumber
      }));
      renderBotBubble(pupukText, recItems);

      setOptions([
        { id: 'back_root', label: '⬅️ Kembali ke Menu Utama', action: () => navigateToNode('root') }
      ]);
      return;
    }

    if (nodeId === 'opt_varietas') {
      let vText = "Pilih varietas tahan untuk penyakit yang sedang mewabah di daerah Anda:";
      renderBotBubble(vText);
      const varOpts = Object.keys(varsMap).map(k => {
        const optObj = optList.find(o => o.id === k);
        const name = optObj ? optObj.nama_lokal : k.toUpperCase();
        return {
          id: `var_${k}`,
          label: `🌱 Varietas Tahan ${name}`,
          action: () => {
            renderUserBubble(`Lihat varietas tahan ${name}`);
            const list = varsMap[k] || [];
            const rItems: RecItem[] = list.map((v: any) => ({
              metode: 'Varietas',
              langkah: v.nama,
              detail: `Ketahanan: ${v.ketahanan}. Keterangan: ${v.keterangan || '-'}`,
              dosis: null,
              waktu_aplikasi: 'Sebelum tanam',
              sumber: 'Balai Besar Penelitian Tanaman Padi (BBPadi / BRIN)'
            }));
            renderBotBubble(`Rekomendasi varietas padi tahan terhadap ${name}:`, rItems);
            setOptions([
              { id: 'back_var', label: '⬅️ Pilih Varietas Lain', action: () => navigateToNode('opt_varietas') },
              { id: 'back_root', label: '🏠 Menu Utama', action: () => navigateToNode('root') }
            ]);
          }
        };
      });
      varOpts.push({ id: 'back_root', label: '⬅️ Menu Utama', action: () => navigateToNode('root') });
      setOptions(varOpts);
      return;
    }

    // Default node rendering
    renderBotBubble(node.txt);

    if (children.length > 0) {
      setOptions(children.map(ch => ({
        id: ch.id,
        label: ch.txt,
        action: () => {
          renderUserBubble(ch.txt);
          navigateToNode(ch.id);
        }
      })));
    } else {
      // If leaf node, offer back navigation
      setOptions([
        { id: 'back_root', label: '🏠 Kembali ke Menu Utama', action: () => navigateToNode('root') }
      ]);
    }
  }

  // Handle direct post-detection parameter (e.g. ?opt=blas)
  function handleUrlParams() {
    const urlParams = new URLSearchParams(window.location.search);
    const optParam = urlParams.get('opt');

    if (optParam) {
      const optItem = optList.find(o => o.id === optParam || o.id === optParam.replace('leaf_', ''));
      const optName = optItem ? optItem.nama_lokal : optParam.toUpperCase();

      renderBotBubble(`📸 Anda dialihkan dari Deteksi Daun untuk menangani: **${optName}**.\n\nPilih fase pertanaman padi Anda saat ini untuk melihat takaran dosis dan rekomendasi:`);

      const phases = ['pratanam', 'pesemaian', 'pertanaman'];
      const phaseLabels: Record<string, string> = {
        'pratanam': '1. Pra-Tanam (Olah Tanah & Bibit)',
        'pesemaian': '2. Fase Pesemaian',
        'pertanaman': '3. Fase Pertanaman (Vegetatif & Generatif)'
      };

      setOptions(phases.map(ph => ({
        id: `rec_${optParam}_${ph}`,
        label: phaseLabels[ph] || ph,
        action: () => {
          renderUserBubble(`Lihat panduan ${phaseLabels[ph]}`);
          const key = `${optItem ? optItem.id : optParam}_${ph}`;
          const recs = recsMap[key] || [];
          renderBotBubble(`Rekomendasi penanganan **${optName}** pada fase **${ph.toUpperCase()}**:`, recs);
          setOptions([
            { id: 'back_phase', label: '⬅️ Pilih Fase Lain', action: () => handleUrlParams() },
            { id: 'back_root', label: '🏠 Kembali ke Menu Utama', action: () => navigateToNode('root') }
          ]);
        }
      })));
      return;
    }

    // Initial root start
    navigateToNode('root');
  }

  // Search feature handler
  function setupSearch() {
    const searchInput = document.getElementById('tanibot-search') as HTMLInputElement;
    if (!searchInput) return;

    searchInput.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        const query = searchInput.value.trim().toLowerCase();
        if (!query) return;

        renderUserBubble(`Cari: "${query}"`);
        searchInput.value = '';

        // Search in OPT
        const matchedOpt = optList.filter(o => 
          o.nama_lokal.toLowerCase().includes(query) ||
          o.deskripsi.toLowerCase().includes(query) ||
          o.gejala.toLowerCase().includes(query)
        );

        if (matchedOpt.length > 0) {
          const opt = matchedOpt[0];
          const recs = recsMap[`${opt.id}_pertanaman`] || [];
          renderBotBubble(`Ditemukan informasi untuk **${opt.nama_lokal}** (*${opt.nama_latin}*):\n\n**Gejala:** ${opt.gejala}\n**Ambang Kendali:** ${opt.ambang_pengendalian}`, recs);
          setOptions([
            { id: 'back_root', label: '🏠 Kembali ke Menu Utama', action: () => navigateToNode('root') }
          ]);
          return;
        }

        // Search in Pupuk
        const matchedPupuk = pupukList.filter(p => 
          p.jenis_pupuk.toLowerCase().includes(query) ||
          p.catatan.toLowerCase().includes(query)
        );
        if (matchedPupuk.length > 0) {
          const p = matchedPupuk[0];
          renderBotBubble(`Informasi Pupuk **${p.jenis_pupuk}**:\n\n• **Dosis Anjuran:** ${p.dosis_per_ha}\n• **Waktu:** ${p.waktu_aplikasi}\n• **Keterangan:** ${p.catatan}`);
          setOptions([
            { id: 'back_root', label: '🏠 Kembali ke Menu Utama', action: () => navigateToNode('root') }
          ]);
          return;
        }

        renderBotBubble(`Maaf, tidak ditemukan hasil spesifik untuk kata kunci "${query}". Silakan pilih topik di menu utama atau periksa penulisan kata.`);
        setOptions([
          { id: 'back_root', label: '🏠 Kembali ke Menu Utama', action: () => navigateToNode('root') }
        ]);
      }
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    handleUrlParams();
    setupSearch();

    document.getElementById('btn-tanibot-reset')?.addEventListener('click', () => {
      const container = document.getElementById('tanibot-messages');
      if (container) container.innerHTML = '';
      navigateToNode('root');
    });
  });
</script>
